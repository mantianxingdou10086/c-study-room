# ============================================================
# 环境变量模板 —— 复制成 .env.local 再填真实值
# 真实值绝不要提交到 git（.env*.local 已在 .gitignore 里）
# ============================================================

# ── 数据库（Supabase）──────────────────────────────────────────
# 取法：Supabase 项目 → Connect → ORM → Prisma，或 Direct 标签里选 Transaction/Session pooler
#
# 1) 事务模式 pooler（端口 6543）——应用运行时用
#    ⚠️ 密码里的特殊字符必须 URL 编码：@ → %40   : → %3A   / → %2F   ? → %3F   # → %23
#    ⚠️ 末尾的 ?pgbouncer=true&connection_limit=1 是必须的：事务模式不支持预处理语句，
#       不加这两个参数，Prisma 在 Vercel 上会出现随机报错 / 连接数耗尽
DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2) 会话模式 pooler（端口 5432）——Prisma 迁移用
#    ⚠️ 免费版的「直连」（db.<ref>.supabase.co:5432）只有 IPv6，很多网络连不上，
#       所以迁移也走会话模式 pooler（IPv4）
DIRECT_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth.js（NextAuth v5）──────────────────────────────────────
# 生成方式：node -e "console.log(crypto.randomUUID())"
# 本地与生产请用不同的值
AUTH_SECRET=""
# 生产环境填真实域名，本地留 http://localhost:3000
AUTH_URL="http://localhost:3000"

# ── Supabase 保活端点鉴权 ──────────────────────────────────────
# /api/keepalive 的访问口令。生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️ 这个变量名是 Vercel 的**约定名**，不能改：设了它以后，Vercel Cron
#    每次调用会自动带上 `Authorization: Bearer <CRON_SECRET>`，无需任何额外配置。
#    端点侧也据此鉴权；不设则端点完全公开（方便接第三方 uptime 监控，
#    但会把表里的记录条数暴露出去）。
CRON_SECRET=""

# ── 站点地址（sitemap / robots / OG 需要绝对地址）────────────────
# 本地开发不用设；部署到 Vercel 绑了自有域名后要显式设成 https://你的域名
# 不设的话会退回 VERCEL_URL（形如 xxx.vercel.app）
# NEXT_PUBLIC_SITE_URL="https://example.com"
# 默认从本站 /toolchain/clang.pkg.gz 加载；要放 CDN 就改这里
# NEXT_PUBLIC_CLANG_PKG_URL=""
# 自托管 @wasmer/sdk 运行时的地址（一般不用改）
# NEXT_PUBLIC_WASMER_SDK_URL="/wasmer/dist/index.js"
